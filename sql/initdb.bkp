CREATE TABLE IF NOT EXISTS users (
    id INT AUTO_INCREMENT,
    email VARCHAR(255) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    full_name VARCHAR(255) NOT NULL,
    telephone VARCHAR(255) NOT NULL,
    user_profile ENUM('ADMIN', 'MANAGER', 'USER') NOT NULL,
    password_expired BOOL NOT NULL DEFAULT TRUE,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_by INT,
    deleted_at DATETIME,
    deleted_by INT,
    number_logins INT DEFAULT 0,
    last_login DATETIME,
    FOREIGN KEY (deleted_by) REFERENCES users(id),
    FOREIGN KEY (created_by) REFERENCES users(id),
    PRIMARY KEY (id)
) default charset=utf8;

CREATE TABLE IF NOT EXISTS laboratories (
    id INT AUTO_INCREMENT,
    name VARCHAR(255) NOT NULL,
    initials VARCHAR(255),
    region VARCHAR(255) NOT NULL,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_by INT NOT NULL,
    FOREIGN KEY (created_by) REFERENCES users(id),
    PRIMARY KEY (id)
) default charset=utf8;


CREATE TABLE IF NOT EXISTS users_laboratories (
    user_id INT NOT NULL,
    laboratory_id INT NOT NULL,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (laboratory_id) REFERENCES laboratories(id),
    PRIMARY KEY (user_id,laboratory_id)
) default charset=utf8;

CREATE TABLE IF NOT EXISTS sectors (
    id INT AUTO_INCREMENT,
    name VARCHAR(255) NOT NULL,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_by INT,
    FOREIGN KEY (created_by) REFERENCES users(id),
    PRIMARY KEY (id)
) default charset=utf8;

CREATE TABLE IF NOT EXISTS exams (
    id INT AUTO_INCREMENT,
    name VARCHAR(255) NOT NULL UNIQUE,
    sector_id INT NOT NULL,
    code_sus VARCHAR(255),
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_by INT,
    deleted_at DATETIME,
    deleted_by INT,
    FOREIGN KEY (deleted_by) REFERENCES users(id),
    FOREIGN KEY (created_by) REFERENCES users(id),
    FOREIGN KEY (sector_id) REFERENCES sectors(id),
    PRIMARY KEY (id)
) default charset=utf8;

CREATE TABLE IF NOT EXISTS exams_history (
    laboratory_id INT NOT NULL,
    exam_id INT NOT NULL,
    period DATE NOT NULL,
    hospitalization_value INT NOT NULL DEFAULT 0,
    ambulatory_value INT NOT NULL DEFAULT 0,
    emergency_value INT NOT NULL DEFAULT 0,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_by INT NOT NULL,
    state ENUM('DRAFT', 'SENT') NOT NULL,
    FOREIGN KEY (created_by) REFERENCES users(id),
    FOREIGN KEY (laboratory_id) REFERENCES laboratories(id),
    FOREIGN KEY (exam_id) REFERENCES exams(id),
    PRIMARY KEY(laboratory_id,exam_id,period)
);

CREATE TABLE IF NOT EXISTS patients_history (
    laboratory_id INT NOT NULL,
    period DATE NOT NULL,
    patients_value INT NOT NULL DEFAULT 0,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_by INT NOT NULL,
    state ENUM('DRAFT', 'SENT') NOT NULL,
    FOREIGN KEY (created_by) REFERENCES users(id),
    FOREIGN KEY (laboratory_id) REFERENCES laboratories(id),
    PRIMARY KEY(laboratory_id,period)
);

CREATE TABLE IF NOT EXISTS history_state (
    laboratory_id INT NOT NULL,
    period DATE NOT NULL,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_by INT NOT NULL,
    modified_at DATETIME,
    state ENUM('DRAFT', 'SENT') NOT NULL,
    FOREIGN KEY (created_by) REFERENCES users(id),
    FOREIGN KEY (laboratory_id) REFERENCES laboratories(id),
    PRIMARY KEY(laboratory_id,period)
);

