CREATE VIEW IF NOT EXISTS exams_history_summary AS SELECT period,exam_id,SUM(hospitalization_value) as hospitalization_value,SUM(ambulatory_value) as ambulatory_value,SUM(emergency_value) as emergency_value FROM exams_history WHERE state = 'SENT' GROUP BY period,exam_id;
