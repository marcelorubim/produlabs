# Configuration file
# Copy this file to application.properties and fill in the actual values
# NEVER commit application.properties to version control!

# JWT Configuration
mp.jwt.verify.publickey.location=META-INF/resources/public.pem
mp.jwt.verify.issuer=br.com.prodlab
quarkus.smallrye-jwt.enabled=true

# Database Configuration
# Use environment variables: %env.DATASOURCE_URL%
quarkus.datasource.url = jdbc:mariadb://localhost:3306/prodlab
quarkus.datasource.driver = org.mariadb.jdbc.Driver
quarkus.datasource.username = ${DB_USERNAME:prodlab}
quarkus.datasource.password = ${DB_PASSWORD:CHANGE_ME}

# Email Configuration
quarkus.mailer.auth-methods=DIGEST-MD5 CRAM-SHA256 CRAM-SHA1 CRAM-MD5 PLAIN LOGIN
quarkus.mailer.from=${MAILER_FROM:produlab.sistema@gmail.com}
quarkus.mailer.host=${MAILER_HOST:smtp.gmail.com}
quarkus.mailer.port=${MAILER_PORT:587}
quarkus.mailer.start-tls=REQUIRED
quarkus.mailer.username=${MAILER_USERNAME:produlab.sistema@gmail.com}
quarkus.mailer.password=${MAILER_PASSWORD:CHANGE_ME}
#quarkus.mailer.mock=false

